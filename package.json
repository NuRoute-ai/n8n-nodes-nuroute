{
  "name": "n8n-nodes-nuroute",
  "version": "1.0.2",
  "description": "n8n community node for NuRoute chat completions",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "author": {
    "name": "Amit Gupta",
    "email": "a.gupta@nuroute.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NuRoute-ai/n8n-nodes-nuroute.git"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/NuRouteApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/NuRoute/NuRoute.node.js"
    ]
  },
  "scripts": {
    "build": "tsc && cp src/nodes/NuRoute/nuroute.png dist/nodes/NuRoute/nuroute.png",
    "dev": "tsc --watch",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "n8n-workflow": "^1.120.0",
    "typescript": "^5.4.0"
  }
}
